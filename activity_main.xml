<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="حضور و غیاب کلاس" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp"/>
<EditText android:id="@+id/className" android:hint="نام کلاس" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/studentName" android:hint="نام دانش‌آموز" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/addStudent" android:text="افزودن دانش‌آموز" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="برای غایب کردن، روی نام دانش‌آموز بزنید" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ListView android:id="@+id/studentList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<Button android:id="@+id/saveAttendance" android:text="ثبت غیبت و ارسال" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
